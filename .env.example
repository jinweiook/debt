# ===== Supabase =====
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# 服务端专用：seed 默认 admin、重置密码。勿加 NEXT_PUBLIC_ 前缀，勿提交 Git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== 数据库（Drizzle → Supabase Postgres）=====
# Dashboard → Connect → Transaction pooler（端口 6543），运行时使用
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 直连（端口 5432），仅 drizzle-kit 执行迁移使用
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ===== 默认管理员（db:migrate 时写入 users 表 + Supabase Auth）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=456123

# Supabase Auth 用 email 登录，这里把 username 映射到该域名下的邮箱
AUTH_EMAIL_DOMAIN=debt.local
