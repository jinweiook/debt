# ===== 数据库方言开关 =====
# mysql（默认，本地开发）| postgres（Supabase 部署）
DB_DIALECT=mysql

# ===== MySQL（DB_DIALECT=mysql 时使用）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=debt
DB_USER=root
DB_PASS=123456
DB_CHARSET=utf8mb4

# ===== Postgres（DB_DIALECT=postgres 时使用）=====
# Dashboard → Connect → Transaction pooler（端口 6543），运行时使用
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 直连（端口 5432），仅 drizzle-kit 执行迁移使用
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ===== 会话签名密钥 =====
# 随机 64 位字符串（node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
# 生产环境必须配置；本地缺省使用内置开发密钥
AUTH_SIGNING_KEY=

# ===== 默认管理员（db:migrate 时写入 users 表）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=456123
