# ===== 数据库连接（本地 Docker MySQL 8 默认值）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=dev123
DB_NAME=debt
DB_SSL=false

# ===== 切换到 TiDB Cloud Serverless 时改为 =====
# DB_HOST=xxxx.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxx.root
# DB_PASSWORD=你的密码
# DB_NAME=debt
# DB_SSL=true

# ===== Redis 缓存与会话（Upstash 示例）=====
# REDIS_URL=rediss://default:密码@xxxxx.upstash.io:6379

# ===== 默认管理员账号（db:migrate 时自动写入 users 表）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
